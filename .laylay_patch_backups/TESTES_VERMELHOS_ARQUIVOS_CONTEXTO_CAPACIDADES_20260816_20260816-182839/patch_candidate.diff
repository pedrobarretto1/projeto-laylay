+"""Fotografia vermelha dos contratos de arquivos, contexto e capacidades.
+
+Este arquivo e deliberadamente escrito contra o comportamento desejado.
+Na baseline ebcaaa27 (teste 3.0), os testes ``test_red__*`` devem falhar
+por assercao sem erro de importacao/coleta; os ``test_guard__*`` devem passar.
+Depois do patch de producao, a mesma bateria vermelha deve ficar verde.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+import os
+
+import pytest
+
+from mente_laylay.arquivos.roteador_arquivos import detectar_intencao_arquivos
+from mente_laylay.autonomia.comandos_imediatos import ComandosImediatosRuntime
+from mente_laylay.cognicao.modalidade_turno import classificar_modalidade_turno
+from mente_laylay.especialistas.caixa_entrada_pessoal import CaixaEntradaPessoalRuntime
+from mente_laylay.especialistas.mapa_habilidades import MapaHabilidadesRuntime
+from mente_laylay.memoria_mental.compatibilidade_contexto import (
+    resolver_repeticao_ultima_acao,
+    texto_pede_repeticao_curta,
+)
+from mente_laylay.memoria_mental.contexto_compartilhado import (
+    registrar_resultado_execucao,
+)
+from mente_laylay.memoria_mental.continuidade_contexto import (
+    registrar_estrutura_arquivo_recente,
+)
+from mente_laylay.memoria_mental.resultado_acao import ResultadoAcao
+
+
+def _normalizar(texto: str) -> str:
+    return str(texto or "").casefold().strip()
+
+
+def _params(**kwargs):
+    return kwargs
+
+
+def _estado_arquivo(caminho: str) -> dict:
+    return registrar_estrutura_arquivo_recente(
+        {},
+        {
+            "tipo": "arquivo",
+            "caminho": caminho,
+            "arquivo_nome": os.path.basename(caminho),
+            "tipo_arquivo": "texto",
+        },
+    )
+
+
+def _detectar_arquivo(texto: str, estado: dict | None = None) -> dict | None:
+    return detectar_intencao_arquivos(
+        texto,
+        params_cb=_params,
+        estado_mental=estado or {},
+    )
+
+
+def _caixa_minima(tmp_path) -> CaixaEntradaPessoalRuntime:
+    return CaixaEntradaPessoalRuntime(
+        caminho=tmp_path / "caixa_red.json",
+        falar=lambda *_args, **_kwargs: None,
+        registrar_resultado=lambda *_args, **_kwargs: None,
+        executar_intencao=lambda *_args, **_kwargs: True,
+        contexto_getter=lambda: {"messages": []},
+        agora=lambda: dt.datetime(2026, 8, 16, 18, 0),
+        log=lambda *_args: None,
+    )
+
+
+def test_guard__catalogo_local_sabe_que_arquivos_sao_capacidade_real() -> None:
+    resposta = MapaHabilidadesRuntime().responder_pergunta_capacidade(
+        "Você consegue apagar arquivos?"
+    )
+    assert resposta
+    assert "arquivo" in _normalizar(resposta)
+
+
+def test_red__pergunta_capacidade_apagar_arquivos_e_tratada_antes_da_barreira_p0() -> None:
+    texto = "Você consegue apagar arquivos?"
+    turno = classificar_modalidade_turno(texto)
+    assert turno["autoriza_execucao"] is False
+
+    falas: list[str] = []
+    execucoes: list[dict] = []
+    consultas_capacidade: list[str] = []
+    mapa = MapaHabilidadesRuntime()
+
+    class Estado:
+        mental = {"turno_atual": turno}
+
+    def responder_capacidade(fala: str) -> str:
+        consultas_capacidade.append(fala)
+        return mapa.responder_pergunta_capacidade(
+            fala,
+            turno=turno,
+            contexto=Estado.mental,
+        )
+
+    runtime = ComandosImediatosRuntime(
+        namespace_getter=lambda: {
+            "_estado_compartilhado_runtime": Estado(),
+            "_responder_pergunta_capacidade_local": responder_capacidade,
+            "falar_com_lipsync": lambda fala, *_args: falas.append(fala),
+            "executar_intencao": lambda intencao, _texto: execucoes.append(intencao) or True,
+        },
+        loop_getter=lambda: None,
+    )
+
+    assert runtime.processar_prioritarios(texto) is True
+    assert consultas_capacidade == [texto]
+    assert falas and "arquivo" in _normalizar(falas[-1])
+    assert execucoes == []
+
+
+def test_red__escrita_eliptica_usa_unico_arquivo_recente_tipado() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    resultado = _detectar_arquivo(
+        "Escreve primeira linha.",
+        _estado_arquivo(caminho),
+    )
+    assert resultado == {
+        "intent": "CREATE_FILE",
+        "params": {
+            "alvo": caminho,
+            "conteudo": "primeira linha",
+            "editar_existente": True,
+        },
+    }
+
+
+def test_red__append_eliptico_usa_unico_arquivo_recente_tipado() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    resultado = _detectar_arquivo(
+        "Acrescente segunda linha.",
+        _estado_arquivo(caminho),
+    )
+    assert resultado == {
+        "intent": "CREATE_FILE",
+        "params": {
+            "alvo": caminho,
+            "conteudo": "segunda linha",
+            "editar_existente": True,
+            "modo_escrita": "append",
+        },
+    }
+
+
+def test_guard__escrita_eliptica_sem_arquivo_recente_nao_adivinha_alvo() -> None:
+    assert _detectar_arquivo("Escreve primeira linha.", {}) is None
+    assert _detectar_arquivo("Acrescente segunda linha.", {}) is None
+
+
+def test_guard__escrita_com_pronome_ja_consumia_referencia_tipificada() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    resultado = _detectar_arquivo(
+        "Escreve primeira linha nele.",
+        _estado_arquivo(caminho),
+    )
+    assert resultado is not None
+    assert resultado["intent"] == "CREATE_FILE"
+    assert resultado["params"]["alvo"] == caminho
+    assert resultado["params"]["conteudo"] == "primeira linha"
+    assert resultado["params"]["editar_existente"] is True
+
+
+def test_red__referencia_tipificada_publicada_alimenta_escrita_da_etapa_seguinte() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    estado = registrar_estrutura_arquivo_recente(
+        {},
+        {
+            "tipo": "arquivo",
+            "caminho": caminho,
+            "arquivo_nome": "caos seguro.txt",
+            "tipo_arquivo": "texto",
+            "origem": "CREATE_FILE",
+        },
+    )
+
+    # A etapa seguinte nao repete nome nem pronome: depende exclusivamente da
+    # referencia tipada viva publicada pela etapa anterior.
+    resultado = _detectar_arquivo("Escreve primeira linha.", estado)
+    assert resultado is not None
+    assert resultado["intent"] == "CREATE_FILE"
+    assert resultado["params"]["alvo"] == caminho
+    assert resultado["params"]["conteudo"] == "primeira linha"
+    assert resultado["params"]["editar_existente"] is True
+
+
+def test_red__leitura_por_nome_reusa_arquivo_recente_equivalente_para_file_read() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    resultado = _detectar_arquivo(
+        "Leia o caos seguro.txt.",
+        _estado_arquivo(caminho),
+    )
+    assert resultado == {
+        "intent": "FILE_READ",
+        "params": {
+            "caminho": caminho,
+            "alvo": "caos seguro.txt",
+            "referencia_contextual": True,
+        },
+    }
+
+
+def test_red__leia_de_novo_e_reconhecido_como_repeticao() -> None:
+    assert texto_pede_repeticao_curta("Leia de novo.", _normalizar) is True
+
+
+def test_red__file_read_confirmado_pode_ser_reexecutado_por_repeticao_segura() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    params = {"caminho": caminho, "alvo": "caos seguro.txt"}
+    estado = registrar_resultado_execucao(
+        {},
+        ResultadoAcao(
+            intent="FILE_READ",
+            status="arquivo_lido",
+            alvo=caminho,
+            params=params,
+            executou=True,
+            confirmado=True,
+        ),
+        "Leia o caos seguro.txt.",
+        True,
+    )
+
+    assert resolver_repeticao_ultima_acao(
+        "de novo",
+        estado,
+        _normalizar,
+    ) == {"intent": "FILE_READ", "params": params}
+
+
+def test_guard__delete_bem_sucedido_continua_nao_reexecutavel() -> None:
+    estado = {
+        "ultima_acao_intent": "DELETE_ITEM",
+        "ultima_acao_params": {"alvo": "C:/tmp/caos seguro.txt", "tipo": "arquivo"},
+        "ultima_acao_status": "movido_para_lixeira",
+        "ultima_acao_ok": True,
+        "ultima_acao_confirmada": True,
+        "ultima_acao_reexecutavel": False,
+    }
+    assert resolver_repeticao_ultima_acao("de novo", estado, _normalizar) is None
+
+
+def test_guard__obrigado_de_novo_nao_e_repeticao_operacional() -> None:
+    assert texto_pede_repeticao_curta("obrigado de novo", _normalizar) is False
+
+
+def test_red__caixa_de_entrada_nao_sequestra_nome_de_arquivo_com_ideia(tmp_path) -> None:
+    caixa = _caixa_minima(tmp_path)
+    assert caixa.detectar("Apaga o troca ideia.txt.") == ""
+
+
+@pytest.mark.parametrize(
+    "fala",
+    [
+        "Apaga o minha tarefa.txt.",
+        "Remove o pensamento.md.",
+        "Exclui a nota.txt.",
+    ],
+)
+def test_red__nomes_de_arquivo_com_vocabulario_da_caixa_nao_sao_sequestrados(
+    tmp_path,
+    fala: str,
+) -> None:
+    caixa = _caixa_minima(tmp_path)
+    assert caixa.detectar(fala) == ""
+
+
+def test_guard__caixa_de_entrada_continua_reconhecendo_exclusao_real_de_nota(tmp_path) -> None:
+    caixa = _caixa_minima(tmp_path)
+    assert caixa.detectar("Apaga essa nota.") == "excluir"
+
+
+def test_red__consulta_arquivo_ainda_existe_reusa_file_search_com_referencia_caminho() -> None:
+    caminho = "C:/tmp/caos seguro.txt"
+    resultado = _detectar_arquivo(
+        "O arquivo ainda existe?",
+        _estado_arquivo(caminho),
+    )
+    assert resultado == {
+        "intent": "FILE_SEARCH",
+        "params": {
+            "query": "caos seguro.txt",
+            "referencia_caminho": caminho,
+            "alvo": "caos seguro.txt",
+        },
+    }
+
+
+def test_guard__consulta_existencia_sem_referencia_nao_inventa_caminho() -> None:
+    resultado = _detectar_arquivo("O arquivo ainda existe?", {})
+    assert not (
+        isinstance(resultado, dict)
+        and str((resultado.get("params") or {}).get("referencia_caminho") or "").strip()
+    )
