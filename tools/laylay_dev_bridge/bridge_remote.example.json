{
  "enabled": true,
  "repo": "owner/repository",
  "allowed_author": "github-user",
  "device": "MY-PC",
  "relay_url": "https://your-relay.example",
  "poll_seconds": 0.2,
  "workspace_root": "C:\\Users\\YOU\\Projects\\project",
  "command_transport": "relay",
  "machine_access": {
    "enabled": true,
    "read_roots": [
      "C:\\"
    ],
    "write_roots": [
      "C:\\Users\\YOU",
      "C:\\Users\\YOU\\Projects\\project"
    ],
    "denied_roots": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\ProgramData",
      "C:\\Recovery",
      "C:\\System Volume Information",
      "C:\\$Recycle.Bin"
    ],
    "write_denied_roots": [
      "C:\\Users\\YOU\\AppData",
      "C:\\Users\\YOU\\LaylayDevBridge"
    ],
    "protected_files": [
      "C:\\Users\\YOU\\LaylayDevBridge\\bridge_remote.json"
    ],
    "allow_process_execution": true,
    "project_python": "C:\\Path\\To\\Python\\python.exe",
    "ui_automation": {
      "enabled": true,
      "profiles": {
        "vscode": {
          "process_names": [
            "Code.exe"
          ],
          "title_contains": [
            "Visual Studio Code"
          ],
          "invoke_control_types": [
            "Button",
            "MenuItem",
            "TabItem",
            "ListItem",
            "TreeItem",
            "CheckBox",
            "RadioButton"
          ]
        },
        "arduino": {
          "process_names": [
            "Arduino IDE.exe"
          ],
          "title_contains": [
            "Arduino IDE"
          ],
          "invoke_control_types": [
            "Button",
            "MenuItem",
            "TabItem",
            "ListItem",
            "TreeItem",
            "CheckBox",
            "RadioButton"
          ]
        },
        "android_studio": {
          "process_names": [
            "studio64.exe"
          ],
          "title_contains": [
            "Android Studio"
          ],
          "invoke_control_types": [
            "Button",
            "MenuItem",
            "TabItem",
            "ListItem",
            "TreeItem",
            "CheckBox",
            "RadioButton"
          ]
        },
        "laylay": {
          "process_names": [
            "python.exe",
            "pythonw.exe",
            "python3.14.exe"
          ],
          "title_contains": [
            "Laylay"
          ],
          "invoke_control_types": [
            "Button",
            "MenuItem",
            "TabItem",
            "ListItem",
            "TreeItem",
            "CheckBox",
            "RadioButton"
          ]
