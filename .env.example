OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Laylay

# Transporte local/remoto. Use o mesmo token forte no PC da Laylay e no PC B.
LAYLAY_WS_HOST=0.0.0.0
LAYLAY_PC_B_TOKEN=
# Raízes adicionais para comandos de arquivo, separadas por ; no Windows.
# Por padrão a Laylay só manipula arquivos dentro da pasta do usuário.
LAYLAY_ARQUIVOS_RAIZES_PERMITIDAS=

# IoT local - deixe vazio no repositorio
IOT_TUYA_TOMADA_VENTILADOR_DEVICE_ID=
IOT_TUYA_TOMADA_VENTILADOR_LOCAL_KEY=
IOT_TUYA_TOMADA_VENTILADOR_IP=
IOT_TUYA_TOMADA_VENTILADOR_VERSION=3.4
IOT_TUYA_LAMPADA_QUARTO_DEVICE_ID=
IOT_TUYA_LAMPADA_QUARTO_LOCAL_KEY=
IOT_TUYA_LAMPADA_QUARTO_IP=
IOT_TUYA_LAMPADA_QUARTO_VERSION=3.5

# Travas deliberadas; nunca habilite em ambiente sem supervisão
LAYLAY_IOT_MODO=simulado
IOT_CONTROLE_FISICO_AUTORIZADO=
IOT_TESTE_FISICO_AUTORIZADO=

# Ouvido local (sounddevice + faster-whisper)
LAYLAY_MICROFONE_ATIVO=1
# Índice do sounddevice ou parte do nome, por exemplo: Realtek
LAYLAY_MICROFONE=
# Vazio usa a saída de áudio padrão atual do Windows.
LAYLAY_SAIDA_AUDIO=
LAYLAY_MICROFONE_SAMPLE_RATE=16000
LAYLAY_MICROFONE_LIMIAR=0.012
LAYLAY_MICROFONE_CALIBRACAO=1.0
LAYLAY_MICROFONE_SILENCIO=0.9
LAYLAY_MICROFONE_MAX_SEGUNDOS=15
LAYLAY_WHISPER_MODELO=turbo
LAYLAY_WHISPER_DEVICE=cpu
LAYLAY_WHISPER_COMPUTE_TYPE=int8
# Confiança média mínima dos segmentos reconhecidos (0 a 1)
LAYLAY_WHISPER_CONFIANCA_MINIMA=0.35
LAYLAY_MEMORIA_VISUAL_RETENCAO_DIAS=7
# Limite do histórico bruto persistido; fatos e resumos continuam separados.
LAYLAY_MEMORIA_MAX_MENSAGENS=240
# Interpretação contextual: off, shadow, conversation, hybrid ou full.
# Main entende e responde na mesma chamada da IA, sem duplicar a espera.
# Use shadow para observar sem mudar o roteamento conversacional.
LAYLAY_INTERPRETACAO_SEMANTICA=main

# Avatar transparente no canto da tela. O tamanho também pode ser alterado
# pelo menu aberto com o botão direito sobre a personagem.
LAYLAY_AVATAR_ATIVO=1
LAYLAY_AVATAR_TAMANHO=230
LAYLAY_AGENDA_DESPERTAR_WINDOWS=1
# Opcional e agressivo: volta a suspender 90 s depois do despertar.
LAYLAY_AGENDA_VOLTAR_SUSPENSAO=0
# JSON opcional, por exemplo: {"estudo":["senai","prova"],"trabalho":["empresa"]}
GMAIL_CATEGORIAS_JSON=

# Economia automática de VRAM durante jogos em tela cheia
LAYLAY_MODO_JOGO_AUTO=1
# Confirma o jogo por alguns segundos para evitar falsos positivos
LAYLAY_MODO_JOGO_ENTRADA_SEGUNDOS=4
# Mantém a GPU livre durante alt-tab e só sai após esta tolerância
LAYLAY_MODO_JOGO_SAIDA_SEGUNDOS=45
