OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Durante jogos, esta rota textual evita disputar VRAM com o jogo. Vazio usa
# o mesmo modelo da visão; a chave continua sendo a GROQ_API_KEY acima.
GROQ_CHAT_MODEL=
LAYLAY_CONVERSA_JOGO_REMOTA_TIMEOUT=8
# Se a rota remota falhar, o modelo local permanece carregado entre falas e
# só libera a VRAM depois deste período sem conversa.
LAYLAY_CONVERSA_JOGO_OCIOSA_SEGUNDOS=60
GEMINI_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Laylay
# Limites de espera: mantêm o Qwen2.5, mas impedem uma chamada lenta de
# congelar a conversa. A pesquisa continua em segundo plano após o limite.
LAYLAY_LLM_LOCAL_TIMEOUT=45
LAYLAY_LLM_GAME_TIMEOUT=20
# A LLM pode dar personalidade às confirmações já verificadas. Em falhas,
# incertezas, demora ou saída contraditória, a frase segura continua valendo.
LAYLAY_CONFIRMACOES_LLM=1
# Tarefas internas usam teto próprio de 12 s no código e nunca herdam os 45 s
# reservados para uma conversa normal fora do jogo.
LAYLAY_PESQUISA_TIMEOUT=4.0

# Transporte local/remoto. Use o mesmo token forte no PC da Laylay e no PC B.
LAYLAY_WS_HOST=0.0.0.0
LAYLAY_PC_B_TOKEN=
# Raízes adicionais para comandos de arquivo, separadas por ; no Windows.
# Por padrão a Laylay só manipula arquivos dentro da pasta do usuário.
LAYLAY_ARQUIVOS_RAIZES_PERMITIDAS=

# IoT local - deixe vazio no repositorio
IOT_TUYA_TOMADA_VENTILADOR_DEVICE_ID=
IOT_TUYA_TOMADA_VENTILADOR_LOCAL_KEY=
IOT_TUYA_TOMADA_VENTILADOR_IP=
IOT_TUYA_TOMADA_VENTILADOR_VERSION=3.4
IOT_TUYA_LAMPADA_QUARTO_DEVICE_ID=
IOT_TUYA_LAMPADA_QUARTO_LOCAL_KEY=
IOT_TUYA_LAMPADA_QUARTO_IP=
IOT_TUYA_LAMPADA_QUARTO_VERSION=3.5

# Travas deliberadas; nunca habilite em ambiente sem supervisão
LAYLAY_IOT_MODO=simulado
IOT_CONTROLE_FISICO_AUTORIZADO=
IOT_TESTE_FISICO_AUTORIZADO=

# Ouvido local (sounddevice + faster-whisper)
LAYLAY_MICROFONE_ATIVO=1
# Índice do sounddevice ou parte do nome, por exemplo: Realtek
LAYLAY_MICROFONE=
# Vazio usa a saída de áudio padrão atual do Windows.
LAYLAY_SAIDA_AUDIO=
# Voz original da Laylay no Edge TTS. A reserva só é usada se a voz principal
# estiver temporariamente indisponível.
LAYLAY_TTS_VOICE=pt-BR-FranciscaNeural
LAYLAY_TTS_VOICE_FALLBACK=pt-BR-ThalitaMultilingualNeural
LAYLAY_TTS_TIMEOUT=8.0
LAYLAY_MICROFONE_SAMPLE_RATE=16000
LAYLAY_MICROFONE_LIMIAR=0.012
LAYLAY_MICROFONE_CALIBRACAO=1.0
LAYLAY_MICROFONE_SILENCIO=0.9
LAYLAY_MICROFONE_MAX_SEGUNDOS=15
LAYLAY_WHISPER_MODELO=turbo
LAYLAY_WHISPER_DEVICE=cpu
LAYLAY_WHISPER_COMPUTE_TYPE=int8
# 0 carrega o modelo apenas na primeira fala e libera o chat mais cedo.
LAYLAY_WHISPER_CARREGAR_NO_INICIO=0
# Confiança média mínima dos segmentos reconhecidos (0 a 1)
LAYLAY_WHISPER_CONFIANCA_MINIMA=0.35
LAYLAY_MEMORIA_VISUAL_RETENCAO_DIAS=7
# Limite do histórico bruto persistido; fatos e resumos continuam separados.
LAYLAY_MEMORIA_MAX_MENSAGENS=240
# Interpretação contextual: off, shadow, conversation, hybrid ou full.
# Main entende e responde na mesma chamada da IA, sem duplicar a espera.
# Use shadow para observar sem mudar o roteamento conversacional.
LAYLAY_INTERPRETACAO_SEMANTICA=main
# Motor central de oportunidades autônomas. Em sombra ele apenas registra o
# que sugeriria ou faria, sem mudar falas nem executar ações.
LAYLAY_INICIATIVA_MODO=sombra
# Rede cognitiva associativa. Em sombra ela aprende relações estruturadas,
# mas ainda não influencia respostas nem executa ações.
LAYLAY_REDE_ASSOCIATIVA_MODO=sombra

# Observador local do clipboard: desligado, sombra ou sugestao. Ele nunca envia
# texto copiado automaticamente à internet e só publica metadados sanitizados
# para o modo companhia.
LAYLAY_CLIPBOARD_OBSERVADOR_MODO=sugestao
LAYLAY_CLIPBOARD_OBSERVADOR_INTERVALO=1
LAYLAY_CLIPBOARD_OBSERVADOR_ESTABILIDADE=3

# Avatar transparente no canto da tela. O tamanho também pode ser alterado
# pelo menu aberto com o botão direito sobre a personagem.
LAYLAY_AVATAR_ATIVO=1
LAYLAY_AVATAR_TAMANHO=230
# Ponte local do widget oficial da Xbox Game Bar. O widget e a Laylay devem usar
# a mesma porta; mantenha o host restrito a 127.0.0.1.
LAYLAY_GAMEBAR_ATIVO=1
LAYLAY_GAMEBAR_PORTA=18766
# Fallback legado para PCs sem Xbox Game Bar. Fica desligado porque alguns
# jogos rejeitam a mudança de tela; o widget oficial não precisa dela.
LAYLAY_OVERLAY_JOGO_BORDERLESS=0
LAYLAY_AGENDA_DESPERTAR_WINDOWS=1
# Opcional e agressivo: volta a suspender 90 s depois do despertar.
LAYLAY_AGENDA_VOLTAR_SUSPENSAO=0
# JSON opcional, por exemplo: {"estudo":["senai","prova"],"trabalho":["empresa"]}
GMAIL_CATEGORIAS_JSON=
# Credenciais do Gmail via IMAP. Prefira cadastrá-las nas variáveis de usuário
# do Windows; estes campos existem apenas para documentar os nomes esperados.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_INTERVALO_S=300
GMAIL_MAX_LIDOS=5

# Economia automática de VRAM durante jogos em tela cheia
LAYLAY_MODO_JOGO_AUTO=1
# Confirma o jogo por alguns segundos para evitar falsos positivos
LAYLAY_MODO_JOGO_ENTRADA_SEGUNDOS=4
# Mantém a GPU livre durante alt-tab e só sai após esta tolerância
LAYLAY_MODO_JOGO_SAIDA_SEGUNDOS=45
# A observação proativa só começa depois de "olha meu inventário" e termina
# automaticamente. Capturas locais verificam mudanças antes de chamar a visão.
LAYLAY_JOGO_PROATIVO=1
LAYLAY_JOGO_PROATIVO_INTERVALO=25
LAYLAY_JOGO_PROATIVO_DURACAO=600
LAYLAY_JOGO_PROATIVO_MAX_ANALISES=12
# Atalho de tecla única: evita Ctrl/Shift presos em jogos com Raw Input.
LAYLAY_HOTKEY_BARRA=f10
