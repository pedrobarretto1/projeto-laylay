{
  "manifest_version": 3,
  "name": "Laylay Chrome Extension",
  "version": "2.9",
  "description": "Extensão para automação do Chrome e comunicação com Laylay em qualquer site.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "tabCapture",
    "offscreen",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["streaming_detector.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html"
  }
}
