{
  "manifest_version": 3,
  "name": "Laylay Chrome Extension",
  "version": "2.1",
  "description": "Extensão para automação do Chrome e comunicação com Laylay em qualquer site.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "index.html"
  }
}
