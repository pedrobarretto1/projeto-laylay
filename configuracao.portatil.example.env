# Motor incluído no pacote. Não requer Ollama instalado.
LAYLAY_LLM_BACKEND=portatil
LAYLAY_LLM_MODEL=Qwen3:4b-instruct
LAYLAY_LLM_PORTA=11435
LAYLAY_LLM_CTX=8192
LAYLAY_LLM_PORTATIL_INICIO_TIMEOUT=90

# Recursos locais
LAYLAY_AVATAR_ATIVO=1
LAYLAY_GAMEBAR_ATIVO=1
LAYLAY_MODO_JOGO_AUTO=1
LAYLAY_CONFIRMACOES_LLM=1
LAYLAY_CLIPBOARD_OBSERVADOR_MODO=sugestao
LAYLAY_CLIPBOARD_OBSERVADOR_INTERVALO=1
LAYLAY_CLIPBOARD_OBSERVADOR_ESTABILIDADE=3

# Interpretação neural local. Shadow observa e aprende sem autorizar execução.
LAYLAY_NEURAL_MODE=shadow
# Opcional: seleciona um candidato apenas para observação; vazio usa modelo_ativo.joblib.
LAYLAY_NEURAL_MODEL_PATH=

# Serviços opcionais. Preencha apenas na sua cópia privada.
GROQ_API_KEY=
GROQ_CHAT_MODEL=
LAYLAY_CONVERSA_JOGO_REMOTA_TIMEOUT=8
LAYLAY_CONVERSA_JOGO_OCIOSA_SEGUNDOS=60
GMAIL_USER=
GMAIL_APP_PASSWORD=

# IoT físico exige autorização explícita e os arquivos privados correspondentes.
LAYLAY_IOT_MODO=simulado
IOT_CONTROLE_FISICO_AUTORIZADO=NAO
