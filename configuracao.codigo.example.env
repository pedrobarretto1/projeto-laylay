# Conversa local para a instalação a partir do GitHub.
LAYLAY_LLM_BACKEND=ollama
LAYLAY_LLM_BASE_URL=http://localhost:11434/v1
LAYLAY_LLM_MODEL=qwen3:4b-instruct

# A configuração inicial não expõe o serviço a outros dispositivos.
LAYLAY_WS_HOST=127.0.0.1
LAYLAY_IOT_MODO=simulado

# A rede neural de comandos, quando instalada, é configurada separadamente.
LAYLAY_NEURAL_MODE=off
LAYLAY_NEURAL_MODEL_PATH=
